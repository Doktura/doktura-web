---
import LoopVideo from '../LoopVideo.astro';
import Rich from '../Rich.astro';
import c from '../../content/startseite/02-ueber-uns.json';
import w from '../../content/startseite/06-warum.json';

const words = c.statement.trim().split(/\s+/);
const gold = c.statementGold.trim().toLowerCase();
const isGold = (w: string) => gold !== '' && w.toLowerCase().replace(/[.,;:!?–]+$/, '') === gold;
---
<section id="ueber-uns" class="section section--light" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__text reveal">
      <p class="label">{c.label}</p>
      <h2 id="about-title" class="h2"><Rich text={c.titel} /></h2>
      <div class="prose about__body">
        <Rich text={c.text} paragraphs />
      </div>
      <p class="about__name"><span>Doktura</span> = Doktor + Struktur</p>
    </div>

    <div class="about__media reveal-media">
      <LoopVideo name="wer-wir-sind" ratio="4 / 5" />
    </div>
  </div>

  <!-- Drei Gründe für Doktura (Texte aus „Warum Doktura“) -->
  <div class="container">
    <h3 class="why__title reveal"><Rich text={w.titel} /></h3>
    <ol class="why__list">
      {w.punkte.map((p, i) => (
        <li class="why__item reveal" style={`--d: ${i}`}>
          <span class="why__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="h3">{p.titel}</h4>
          <p class="muted"><Rich text={p.text} /></p>
        </li>
      ))}
    </ol>
  </div>

  <!-- Großes Statement: füllt sich beim Scrollen Wort für Wort -->
  <div class="container">
    <p class="statement">
      {words.map((w, i) => (
        <span class:list={['statement__word', { 'statement__word--gold': isGold(w) }]} style={`--p: ${(i / words.length).toFixed(3)}`}>{w}</span>
      ))}
    </p>
  </div>
</section>

<style>
  .about { display: grid; gap: 3rem; align-items: center; }
  .about__text { display: grid; gap: 1.75rem; }
  .about__body { color: var(--c-text-muted-light); }
  .why__title { margin: clamp(4rem, 3rem + 4vw, 7rem) 0 clamp(2rem, 1.5rem + 2vw, 3rem); font-family: var(--font-display); font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem); line-height: var(--lh-head); }
  .why__list { list-style: none; display: grid; gap: 2rem; }
  .why__item { position: relative; display: grid; gap: 0.5rem; align-content: start; padding-top: 1.25rem; }
  .why__item::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 1px; background: var(--c-gold); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .why__item::before { transform: scaleX(0); transition: transform 1300ms var(--ease) calc(150ms + var(--d, 0) * 110ms); }
    :global(.js) .why__item:global(.is-visible)::before { transform: none; }
  }
  .why__num { font-size: var(--fs-label); font-weight: 600; letter-spacing: var(--tracking-label); color: var(--c-gold-text); }
  @media (min-width: 48rem) { .why__list { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  .statement {
    margin-top: clamp(4rem, 3rem + 5vw, 8rem);
    font-family: var(--font-display); font-size: clamp(2.25rem, 1.2rem + 4.6vw, 5.5rem);
    line-height: 1.08; letter-spacing: -0.015em; max-width: 18ch; text-wrap: balance;
    view-timeline-name: --statement;
  }
  .statement__word { display: inline-block; margin-right: 0.24em; color: var(--c-aubergine); }
  .statement__word--gold { color: var(--c-gold-text); }

  /* Wort für Wort einfärben, passend zur Scrollposition */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement__word {
        animation: word-fill linear both;
        animation-timeline: --statement;
        animation-range: cover calc(22% + var(--p) * 30%) cover calc(30% + var(--p) * 30%);
      }
    }
  }
  @keyframes word-fill { from { color: #cdc4da; transform: translateY(0.12em); } }
  .about__name {
    padding-top: 1.5rem; border-top: 1px solid var(--c-line-light); max-width: var(--measure);
    font-size: var(--fs-small); color: var(--c-text-muted-light);
  }
  .about__name span { font-family: var(--font-serif); color: var(--c-aubergine); }
  /* Handy: Bild flacher, damit der Abschnitt nicht so lang wird */
  @media (max-width: 63.99rem) { .about__media :global(video) { aspect-ratio: 16 / 10 !important; } }
  @media (min-width: 64rem) {
    .about { grid-template-columns: 1.15fr 0.85fr; gap: 6rem; }
  }
</style>
