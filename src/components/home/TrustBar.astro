---
import c from '../../content/startseite/01-hero.json';
const items = c.vorteile;
---
<div class="trust section--dark">
  <ul class="container trust__list" aria-label="Das Wichtigste in Kürze">
    {items.map((item) => (
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12.5l5 5L20 6.5" /></svg>
        {item}
      </li>
    ))}
  </ul>
</div>

<style>
  .trust { padding-block: 0 clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  .trust__list {
    position: relative; list-style: none; display: grid; gap: 1rem;
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .trust__list::before {
    content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter);
    height: 1px; background: var(--c-aubergine-line); transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .trust__list::before { animation: trust-line 1400ms var(--ease) 600ms both; }
    .trust__list li { animation: trust-in 900ms var(--ease) both; }
    .trust__list li:nth-child(1) { animation-delay: 800ms; }
    .trust__list li:nth-child(2) { animation-delay: 920ms; }
    .trust__list li:nth-child(3) { animation-delay: 1040ms; }
  }
  @keyframes trust-line { from { transform: scaleX(0); } }
  @keyframes trust-in { from { opacity: 0; transform: translateY(10px); } }
  .trust__list li { display: flex; align-items: center; gap: 0.875rem; color: var(--c-offwhite); font-weight: 500; }
  .trust svg { flex: none; width: 1.25rem; height: 1.25rem; fill: none; stroke: var(--c-gold); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 48rem) {
    .trust__list { grid-template-columns: repeat(3, auto); justify-content: space-between; }
  }
</style>
