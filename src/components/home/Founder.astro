---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import Rich from '../Rich.astro';
import { site, legal } from '../../site.config';
import c from '../../content/startseite/04-zamin.json';
import buero from '../../assets/images/zamin-buero.jpg';
---
<section id="zamin" class="section section--light founder" aria-labelledby="founder-title">
  <div class="container founder__grid">
    <div class="founder__photo reveal-media">
      <Picture src={buero} formats={['avif', 'webp']} widths={[400, 640]} sizes="(min-width: 64rem) 34vw, 90vw" alt="Zamin Köhler im Büro" />
    </div>

    <div class="founder__text">
      <p class="label reveal">{c.label}</p>
      <blockquote class="reveal" style="--d: 1">
        <p id="founder-title" class="h2 founder__quote">„<Rich text={c.zitat} />“</p>
      </blockquote>
      <div class="prose founder__body reveal" style="--d: 2"><Rich text={c.text} paragraphs /></div>

      <dl class="founder__facts reveal" style="--d: 3">
        {c.fakten.map((f) => <div><dt>{f.titel}</dt><dd>{f.text}</dd></div>)}
        <div>
          <dt>Vermittlerregister</dt>
          <dd><a href="https://www.vermittlerregister.info" target="_blank" rel="noopener">{legal.registerNo} <Icon name="arrow-up-right" /></a></dd>
        </div>
      </dl>

      <div class="reveal" style="--d: 4">
        <a class="btn" href={site.calUrl} {...site.calAttrs}>{c.button} <Icon name={site.calIcon} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .founder__grid { display: grid; gap: 2.5rem; align-items: center; }
  .founder__photo { max-width: 26rem; aspect-ratio: 4 / 5; overflow: hidden; }
  .founder__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .founder__text { display: grid; gap: 1.5rem; justify-items: start; }
  blockquote { margin: 0; }
  .founder__quote { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem); line-height: 1.1; }
  .founder__quote :global(em) { font-family: var(--font-serif); color: var(--c-gold-text); }
  .founder__body { color: var(--c-text-muted-light); }
  .founder__facts { display: grid; gap: 0; width: 100%; margin: 0; border-top: 1px solid var(--c-line-light); }
  .founder__facts > div { display: grid; grid-template-columns: 12.5rem 1fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--c-line-light); font-size: 0.9375rem; }
  .founder__facts dt { font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-gold-text); padding-top: 0.1rem; }
  .founder__facts dd { margin: 0; }
  .founder__facts a { display: inline-flex; align-items: center; gap: 0.375rem; text-decoration: none; border-bottom: 1px solid var(--c-line-light); }
  .founder__facts :global(svg) { width: 0.875rem; height: 0.875rem; }

  @media (max-width: 39.99rem) {
    .founder__photo { max-width: 13rem; }
    .founder__facts > div { grid-template-columns: 1fr; gap: 0.125rem; }
  }
  @media (min-width: 64rem) {
    .founder__grid { grid-template-columns: 0.8fr 1.2fr; gap: 6rem; }
    .founder__photo { max-width: none; }
  }
</style>
