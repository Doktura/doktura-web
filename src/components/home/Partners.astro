---
// Partner-Laufband: zwei Reihen mit Versicherern und Banken, die gegenläufig durchlaufen.
// Namen als ruhige Wortmarken in der Hausschrift (einheitlich und ohne fremde Logo-Dateien).
import Rich from '../Rich.astro';
import c from '../../content/startseite/11-partner.json';
const rows = [c.reihe1, c.reihe2].filter((r) => r && r.length);
---
{rows.length > 0 && (
<section id="partner" class="section section--dark partners" aria-labelledby="partners-title">
  <div class="container partners__head reveal">
    <p class="label">{c.label}</p>
    <h2 id="partners-title" class="h2"><Rich text={c.titel} /></h2>
    <p class="muted">{c.text}</p>
  </div>

  <div class="partners__rows">
    {rows.map((row, r) => (
      <div class:list={['marquee', r % 2 === 1 && 'marquee--reverse']} aria-hidden={r > 0 ? 'true' : undefined}>
        <ul class="marquee__track">
          {[...row, ...row].map((name, i) => (
            <li aria-hidden={i >= row.length ? 'true' : undefined}>{name}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {c.hinweis && <p class="container partners__note">{c.hinweis}</p>}
</section>
)}

<style>
  .partners { overflow: hidden; }
  .partners__head { display: grid; gap: 1.25rem; justify-items: center; text-align: center; max-width: 48rem; margin-bottom: clamp(2.5rem, 2rem + 3vw, 4rem); }
  .partners__head :global(em) { font-family: var(--font-serif); font-style: italic; color: var(--c-gold); }
  .partners__rows { display: grid; gap: clamp(1rem, 0.75rem + 1vw, 1.75rem); }
  .marquee {
    overflow: hidden; border-block: 1px solid var(--c-aubergine-line);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee__track { list-style: none; display: flex; width: max-content; margin: 0; padding: 0; }
  .marquee__track li {
    display: flex; align-items: center; gap: clamp(2rem, 1.5rem + 2vw, 3.5rem); padding: 1.25rem 0 1.25rem clamp(2rem, 1.5rem + 2vw, 3.5rem);
    font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); line-height: 1; white-space: nowrap;
    color: rgb(244 238 247 / 0.72); transition: color 300ms var(--ease);
  }
  .marquee__track li::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--c-gold); opacity: 0.8; }
  .marquee:hover .marquee__track li { color: rgb(244 238 247 / 0.5); }
  .marquee .marquee__track li:hover { color: var(--c-gold); }
  .partners__note { margin-top: 1.5rem; font-size: 0.75rem; color: var(--c-text-muted-dark); text-align: center; }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track { animation: marquee 48s linear infinite; }
    .marquee--reverse .marquee__track { animation-direction: reverse; animation-duration: 56s; }
    .marquee:hover .marquee__track { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { flex-wrap: wrap; width: auto; justify-content: center; }
  }
  @keyframes marquee { to { transform: translateX(-50%); } }
</style>
