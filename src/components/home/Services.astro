---
import ServiceIcon from '../ServiceIcon.astro';
import Rich from '../Rich.astro';
import c from '../../content/startseite/03-leistungen.json';
---
<section id="leistungen" class="section section--dark" aria-labelledby="services-title">
  <div class="container">
    <header class="services__head reveal">
      <p class="label">{c.label}</p>
      <h2 id="services-title" class="h2"><Rich text={c.titel} /></h2>
      <p class="lead muted"><Rich text={c.einleitung} /></p>
    </header>

    <ul class="services__grid">
      {c.leistungen.map((s, i) => (
        <li class="service reveal" style={`--d: ${i}`} data-spotlight>
          <ServiceIcon name={s.icon} />
          <div>
            <h3 class="service__title">{s.titel}</h3>
            <p class="service__text"><Rich text={s.text} /></p>
          </div>
        </li>
      ))}
    </ul>

    <!-- Phasen als ruhige Zeitleiste statt eigener Abschnitt -->
    <div class="phases reveal">
      <p class="phases__title">{c.phasenTitel}</p>
      <ol class="phases__line">
        {c.phasen.map((p, i) => <li><span>0{i + 1}</span>{p}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .services__head { display: grid; gap: 1.5rem; max-width: 50rem; margin-bottom: clamp(2.5rem, 2rem + 3vw, 4rem); }
  .services__grid { list-style: none; display: grid; gap: 1px; background: var(--c-aubergine-line); border: 1px solid var(--c-aubergine-line); }
  .service {
    position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start;
    padding: 1.75rem 1.5rem; background: var(--c-aubergine);
    background-image: radial-gradient(28rem circle at var(--x, -100%) var(--y, -100%), rgb(191 158 93 / 0.09), transparent 60%);
  }
  .service :global(svg) { width: 2.25rem; height: 2.25rem; color: var(--c-gold); }
  .service__title { font-family: var(--font-serif); font-size: 1.375rem; line-height: 1.25; margin-bottom: 0.5rem; }
  .service__text { color: var(--c-text-muted-dark); }

  .phases { margin-top: clamp(3rem, 2rem + 3vw, 4.5rem); }
  .phases__title { margin-bottom: 1.25rem; font-size: var(--fs-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-gold); }
  .phases__line { list-style: none; display: grid; gap: 0; counter-reset: p; }
  .phases__line li {
    position: relative; display: flex; align-items: baseline; gap: 0.875rem;
    padding: 0.75rem 0 0.75rem 1.5rem; border-left: 1px solid var(--c-aubergine-line); font-family: var(--font-serif); font-size: 1.125rem;
  }
  .phases__line li::before { content: ''; position: absolute; left: -4px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--c-gold); }
  .phases__line span { font-family: var(--font-sans); font-size: 0.8125rem; color: var(--c-gold); }

  @media (min-width: 48rem) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
    .service { padding: 2.5rem 2.25rem; }
    .phases__line { grid-template-columns: repeat(4, 1fr); }
    .phases__line li { flex-direction: column; gap: 0.25rem; padding: 1.5rem 1rem 0 0; border-left: 0; border-top: 1px solid var(--c-aubergine-line); }
    .phases__line li::before { left: 0; top: -4px; margin-top: 0; }
  }
</style>
