---
import Logo from './Logo.astro';
import { site } from '../site.config';
---
<footer class="site-footer section--dark">
  <div class="container">
    <div class="site-footer__top">
      <a href="/" class="site-footer__logo" aria-label="Doktura – zur Startseite"><Logo /></a>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Kontakt</h2>
        <p>{site.contact.person}</p>
        <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        {site.contact.phone && <p><a href={`tel:${site.contact.phone.replace(/[^+\d]/g, '')}`}>{site.contact.phone}</a></p>}
        <p>{site.contact.address}</p>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Rechtliches</h2>
        <ul>
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
          <li><a href="/erstinformation">Erstinformation</a></li>
          {/* Cookie-Einstellungen: wieder einblenden, sobald es ein Cookie-Banner gibt (z. B. für das Meta Pixel) */}
        </ul>
      </div>

      {site.instagram && <div class="site-footer__col">
        <h2 class="site-footer__title">Folgen</h2>
        <ul>
          <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>}
    </div>

    <p class="site-footer__copy">© {site.year} Doktura</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(4rem, 3rem + 4vw, 6rem) 2rem; border-top: 1px solid var(--c-aubergine-line); }
  .site-footer__top { display: grid; gap: 2.5rem; }
  .site-footer__logo { display: block; width: min(15rem, 70%); color: var(--c-offwhite); }
  .site-footer__title {
    margin-bottom: 0.875rem; font-size: var(--fs-label); font-weight: 600;
    letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-gold);
  }
  .site-footer__col { color: var(--c-text-muted-dark); }
  .site-footer__col > p + p { margin-top: 0.25rem; }
  .site-footer__col > p:not(:has(a)) { padding-block: 0.375rem; }
  .site-footer ul { list-style: none; display: grid; gap: 0.25rem; }
  .site-footer a, .site-footer__linkbtn {
    display: inline-block; padding-block: 0.375rem; color: var(--c-text-muted-dark);
    text-decoration: none; transition: color 200ms var(--ease);
  }
  .site-footer__linkbtn { background: none; border: 0; padding-inline: 0; cursor: pointer; text-align: left; }
  .site-footer a:hover, .site-footer__linkbtn:hover { color: var(--c-offwhite); }
  .site-footer__copy {
    margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--c-aubergine-line);
    font-size: var(--fs-small); color: var(--c-text-muted-dark);
  }
  @media (min-width: 48rem) {
    .site-footer__top { grid-template-columns: 1.6fr 1fr 1fr 0.8fr; gap: 3rem; }
  }
</style>
