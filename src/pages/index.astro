---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Check from '../components/home/Check.astro';
import Services from '../components/home/Services.astro';
import Founder from '../components/home/Founder.astro';
import Erstgespraech from '../components/home/Erstgespraech.astro';
import Faq from '../components/home/Faq.astro';
import StickyCta from '../components/home/StickyCta.astro';
---
<Base>
  <Hero />          <!-- Aubergine: Zamin, „Ich berate nur Ärzte.“ (wie die Anzeigen) -->
  <Check />         <!-- Off-White: 5-Punkte-Check zum Antippen -->
  <Services />      <!-- Aubergine: 4 Leistungen + Phasen als Zeitleiste -->
  <Founder />       <!-- Off-White: Zamin, Zitat, Nachweise -->
  <Erstgespraech /> <!-- Aubergine: Ablauf, Kosten, Vergütung, Formular -->
  <Faq />           <!-- Off-White: häufige Fragen -->
  <StickyCta />     <!-- Nur Handy: fester Termin-Button beim Scrollen -->
</Base>
