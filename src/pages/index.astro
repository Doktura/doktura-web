---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import About from '../components/home/About.astro';
import Services from '../components/home/Services.astro';
import Phases from '../components/home/Phases.astro';
import Founder from '../components/home/Founder.astro';
import Why from '../components/home/Why.astro';
import Process from '../components/home/Process.astro';
import Infection from '../components/home/Infection.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';
import Closing from '../components/home/Closing.astro';
---
<Base>
  <Hero />          <!-- Aubergine: Wer, für wen, Zamin -->
  <TrustBar />      <!-- Aubergine, gehört zum Hero -->
  <About />         <!-- Off-White: Wer wir sind + großes Statement -->
  <Services />      <!-- Aubergine: 8 Leistungen -->
  <Phases />        <!-- Off-White: Situationen im Berufsweg -->
  <Founder />       <!-- Aubergine: Zamin, Werdegang, Zitat, Video -->
  <Why />           <!-- Off-White: Warum Doktura, Transparenz, Nachweise -->
  <Process />       <!-- Aubergine: Ablauf + Erstgespräch im Detail -->
  <Infection />     <!-- Off-White: Beispiel Infektionsklausel -->
  <Faq />           <!-- Aubergine: Häufige Fragen -->
  <Contact />       <!-- Off-White: Formular + Termin -->
  <Closing />       <!-- Aubergine -->
</Base>
