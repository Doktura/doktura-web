---
// Internes Team-Dashboard: Launch-Checkliste, wer was macht, Zeitplan.
// Geschützt per Passwort (netlify/edge-functions/team-schutz.ts), nicht in der Sitemap, nicht verlinkt, noindex.
// Inhalte bearbeiten: doktura.de/admin → „Team-Dashboard (intern)“. Nach dem Speichern ist die Seite in 1–2 Minuten aktuell.
// Achtung: Das GitHub-Repo ist öffentlich, die Inhalte (src/content/dashboard.json) sind dort lesbar.
import Base from '../layouts/Base.astro';
import d from '../content/dashboard.json';

type Todo = (typeof d.todos)[number];

const personen = [
  { name: 'Leon', rolle: 'Marketing, Website, Anzeigen' },
  { name: 'Zamin', rolle: 'Beratung, Inhalte, Rechtliches' },
];

const statusText: Record<string, string> = { offen: 'Offen', arbeit: 'In Arbeit', wartet: 'Wartet', erledigt: 'Erledigt' };
const prioRang: Record<string, number> = { hoch: 0, normal: 1, niedrig: 2 };
const statusRang: Record<string, number> = { arbeit: 0, offen: 1, wartet: 2, erledigt: 3 };
const sortiert = (a: Todo, b: Todo) =>
  (statusRang[a.status] ?? 9) - (statusRang[b.status] ?? 9) ||
  (prioRang[a.prio] ?? 9) - (prioRang[b.prio] ?? 9) ||
  (a.faellig || '9999').localeCompare(b.faellig || '9999');

const todos = d.todos.filter((t) => personen.some((p) => p.name === t.wer) || t.wer === 'Beide');
const gehoert = (t: Todo, name: string) => t.wer === name || t.wer === 'Beide';
const offen = todos.filter((t) => t.status !== 'erledigt');
const erledigt = todos.filter((t) => t.status === 'erledigt');

// Launch-Bereitschaft aus der Checkliste
const gruppen = d.checkliste.map((g) => {
  const fertig = g.punkte.filter((p) => p.erledigt).length;
  return { ...g, fertig, gesamt: g.punkte.length, pct: g.punkte.length ? Math.round((fertig / g.punkte.length) * 100) : 0,
    punkte: [...g.punkte].sort((a, b) => Number(b.erledigt) - Number(a.erledigt)) };
});
const alleFertig = gruppen.reduce((s, g) => s + g.fertig, 0);
const alleGesamt = gruppen.reduce((s, g) => s + g.gesamt, 0);
const bereitschaft = alleGesamt ? Math.round((alleFertig / alleGesamt) * 100) : 0;

const R = 52, U = 2 * Math.PI * R;
const bogen = (pct: number) => `${(U * pct) / 100} ${U}`;

const datum = (iso: string, opts: Intl.DateTimeFormatOptions = { weekday: 'short', day: '2-digit', month: '2-digit' }) =>
  iso ? new Date(`${iso.slice(0, 10)}T12:00:00`).toLocaleDateString('de-DE', opts) : '';
const gebaut = new Date().toLocaleString('de-DE', { timeZone: 'Europe/Berlin', weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
const meilensteine = [...d.meilensteine].sort((a, b) => a.datum.localeCompare(b.datum));
const editUrl = '/admin/#/collections/dashboard/entries/dashboard';
---
<Base funnel noindex title="Team-Dashboard" description="Interner Bereich.">
  <section class="top section--dark">
    <div class="container top__grid">
      <div class="top__text">
        <p class="label">Intern · Team-Dashboard</p>
        <h1 class="h2 top__title">Stand der <em>Dinge</em></h1>
        <p class="muted top__meta">Aktualisiert: {gebaut} Uhr</p>
        {d.fokus && <p class="top__fokus"><b>Im Fokus</b>{d.fokus}</p>}
        <div class="top__actions">
          <a class="btn" href={editUrl}>Aufgaben bearbeiten</a>
          <a class="top__link" href="/team?abmelden">Abmelden</a>
        </div>
      </div>
      <div class="ring ring--gross" style={`--pct:${bereitschaft}`}>
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle cx="60" cy="60" r={R} class="ring__bg" />
          <circle cx="60" cy="60" r={R} class="ring__fg" stroke-dasharray={bogen(bereitschaft)} />
        </svg>
        <div class="ring__mitte">
          <span class="ring__zahl">{bereitschaft}<small>%</small></span>
          <span class="ring__text">startklar</span>
        </div>
        <p class="ring__unter">{alleFertig} von {alleGesamt} Punkten für den Launch erledigt</p>
      </div>
    </div>

    <div class="container">
      <dl class="kpis">
        <div data-countdown={d.countdownDatum}><dt>Tage bis {d.countdownTitel}</dt><dd data-countdown-zahl>–</dd><span>{datum(d.countdownDatum, { weekday: 'long', day: '2-digit', month: 'long' })}</span></div>
        <div><dt>Offene Aufgaben</dt><dd>{offen.length}</dd><span>davon {offen.filter((t) => t.prio === 'hoch').length} wichtig</span></div>
        <div class="kpis__warn"><dt>Überfällig</dt><dd data-ueberfaellig-zahl>0</dd><span>Fälligkeit verpasst</span></div>
        <div class="kpis__gut"><dt>Erledigte Aufgaben</dt><dd>{erledigt.length}</dd><span>seit Projektstart</span></div>
      </dl>
    </div>
  </section>

  <section class="sec section--light">
    <div class="container">
      <div class="sec__head">
        <p class="label">Checkliste</p>
        <h2 class="h3">Was wir zum Online-Gehen brauchen</h2>
      </div>
      <div class="checks">
        {gruppen.map((g) => (
          <article class={`check ${g.pct === 100 ? 'is-fertig' : ''}`}>
            <header class="check__head">
              <div class="ring ring--klein">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle cx="60" cy="60" r={R} class="ring__bg" />
                  <circle cx="60" cy="60" r={R} class="ring__fg" stroke-dasharray={bogen(g.pct)} />
                </svg>
                <span class="ring__zahl">{g.pct}<small>%</small></span>
              </div>
              <div>
                <h3 class="check__name">{g.bereich}</h3>
                <p class="check__count">{g.fertig} von {g.gesamt} erledigt</p>
              </div>
            </header>
            <ul class="check__list">
              {g.punkte.map((p) => (
                <li class={p.erledigt ? 'is-done' : 'is-open'}>
                  <span class="check__box" aria-label={p.erledigt ? 'erledigt' : 'offen'}>{p.erledigt ? '✓' : ''}</span>
                  <span class="check__punkt">{p.punkt}</span>
                  {!p.erledigt && p.wer && <span class={`chip chip--${p.wer.toLowerCase()}`}>{p.wer}</span>}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="sec__head">
        <p class="label">Aufgaben</p>
        <h2 class="h3">Wer macht was</h2>
      </div>
      <div class="people">
        {personen.map((p) => {
          const meine = todos.filter((t) => gehoert(t, p.name));
          const auf = meine.filter((t) => t.status !== 'erledigt').sort(sortiert);
          const fertig = meine.filter((t) => t.status === 'erledigt');
          const pct = meine.length ? Math.round((fertig.length / meine.length) * 100) : 0;
          return (
            <article class="person">
              <header class="person__head">
                <span class={`avatar avatar--${p.name.toLowerCase()}`} aria-hidden="true">{p.name[0]}</span>
                <div class="person__wer">
                  <h3 class="person__name">{p.name}</h3>
                  <p class="person__rolle">{p.rolle}</p>
                </div>
                <div class="person__stat"><b>{auf.length}</b> offen</div>
              </header>
              <div class="bar"><i style={`width:${pct}%`}></i></div>
              <p class="bar__text">{fertig.length} von {meine.length} Aufgaben erledigt</p>

              {auf.length === 0 ? <p class="leer">Alles erledigt.</p> : (
                <ul class="todos">
                  {auf.map((t) => (
                    <li class={`todo todo--${t.status} todo--${t.prio}`} data-faellig={t.faellig || undefined}>
                      <div class="todo__main">
                        <p class="todo__text">{t.aufgabe}</p>
                        <p class="todo__meta">
                          <span class={`tag tag--${t.status}`}>{statusText[t.status] ?? t.status}</span>
                          {t.prio === 'hoch' && <span class="tag tag--hoch">Wichtig</span>}
                          {t.wer === 'Beide' && <span class="tag">Gemeinsam</span>}
                          <span class="tag tag--late" hidden>Überfällig</span>
                          <span>{t.bereich}</span>
                        </p>
                        {t.notiz && <p class="todo__notiz">{t.notiz}</p>}
                      </div>
                      {t.faellig && (
                        <div class="todo__datum">
                          <span>{datum(t.faellig, { day: '2-digit' })}</span>
                          <small>{datum(t.faellig, { month: 'short' })}</small>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              )}

              {fertig.length > 0 && (
                <div class="done">
                  <p class="done__title">Erledigt</p>
                  <ul>
                    {fertig.map((t) => (
                      <li><span class="done__haken">✓</span><span>{t.aufgabe}</span>{t.faellig && <small>{datum(t.faellig, { day: '2-digit', month: '2-digit' })}</small>}</li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          );
        })}
      </div>

      <div class="sec__head">
        <p class="label">Zeitplan</p>
        <h2 class="h3">Die nächsten Wochen</h2>
      </div>
      <ol class="time">
        {meilensteine.map((m) => (
          <li data-datum={m.datum}>
            <span class="time__dot" aria-hidden="true"></span>
            <span class="time__date">{datum(m.datum, { day: '2-digit', month: '2-digit' })}</span>
            <span class="time__title">{m.titel}</span>
          </li>
        ))}
      </ol>

      <p class="hinweis">Interne Seite. Bitte keine Kundendaten, Zahlen oder Passwörter eintragen: Die Inhalte liegen im öffentlichen GitHub-Repo.</p>
    </div>
  </section>
</Base>

<script>
  // Tagesaktuell im Browser: Countdown, überfällige Aufgaben, vergangene Termine
  const heute = new Date();
  heute.setHours(0, 0, 0, 0);
  const tag = (iso: string) => new Date(`${iso.slice(0, 10)}T00:00:00`);

  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd?.dataset.countdown) {
    const tage = Math.round((tag(cd.dataset.countdown).getTime() - heute.getTime()) / 86400000);
    const zahl = cd.querySelector('[data-countdown-zahl]')!;
    zahl.textContent = tage > 0 ? String(tage) : tage === 0 ? 'Heute' : 'Vorbei';
  }

  let ueberfaellig = 0;
  document.querySelectorAll<HTMLElement>('.todo[data-faellig]').forEach((el) => {
    if (tag(el.dataset.faellig!) < heute) {
      el.classList.add('is-late');
      el.querySelector<HTMLElement>('.tag--late')!.hidden = false;
      ueberfaellig++;
    }
  });
  const uz = document.querySelector('[data-ueberfaellig-zahl]');
  if (uz) uz.textContent = String(ueberfaellig);
  if (ueberfaellig > 0) uz?.parentElement?.classList.add('is-on');

  let naechster = false;
  document.querySelectorAll<HTMLElement>('[data-datum]').forEach((el) => {
    if (tag(el.dataset.datum!) < heute) el.classList.add('is-past');
    else if (!naechster) { el.classList.add('is-next'); naechster = true; }
  });
</script>

<style>
  /* ---------- Kopf ---------- */
  .top { padding-block: 8.5rem 3rem; background-image: radial-gradient(60rem 36rem at 85% -10%, rgb(191 158 93 / 0.18), transparent 60%); }
  .top__grid { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; }
  .top__title { margin-top: 1rem; }
  .top__title em { color: var(--c-gold); }
  .top__meta { margin-top: 0.5rem; font-size: var(--fs-small); }
  .top__fokus { margin-top: 1.75rem; padding: 1rem 1.25rem; border-left: 2px solid var(--c-gold); background: rgb(240 237 246 / 0.05); font-size: 1.125rem; line-height: 1.5; max-width: 60ch; }
  .top__fokus b { display: block; margin-bottom: 0.25rem; font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-gold); }
  .top__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 1.75rem; }
  .top__link { color: var(--c-text-muted-dark); text-decoration: underline; text-underline-offset: 3px; }
  .top__link:hover { color: var(--c-offwhite); }

  /* ---------- Ringe ---------- */
  .ring { position: relative; display: grid; place-items: center; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 9; }
  .ring__bg { stroke: var(--c-aubergine-line); }
  .ring__fg { stroke: var(--c-gold); stroke-linecap: round; }
  .ring--gross { width: 15rem; text-align: center; }
  .ring--gross svg { width: 15rem; height: 15rem; }
  .ring--gross .ring__mitte { position: absolute; top: 0; left: 0; width: 15rem; height: 15rem; display: grid; place-content: center; }
  .ring--gross .ring__zahl { font-family: var(--font-display); font-size: 4rem; line-height: 1; color: var(--c-offwhite); }
  .ring__zahl small { font-size: 0.45em; margin-left: 0.1em; color: var(--c-gold); }
  .ring__text { font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-gold); margin-top: 0.375rem; }
  .ring__unter { margin-top: 0.75rem; font-size: 0.9375rem; color: var(--c-text-muted-dark); }

  .ring--klein { flex: none; width: 4.5rem; height: 4.5rem; }
  .ring--klein .ring__bg { stroke: var(--c-offwhite-deep); }
  .ring--klein circle { stroke-width: 11; }
  .ring--klein .ring__zahl { position: absolute; font-weight: 700; font-size: 1.0625rem; color: var(--c-aubergine); }
  .ring--klein .ring__zahl small { color: var(--c-gold-text); }

  /* ---------- Kennzahlen ---------- */
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 3rem; background: var(--c-aubergine-line); border: 1px solid var(--c-aubergine-line); }
  .kpis div { display: grid; padding: 1.25rem 1.5rem; background: var(--c-aubergine-soft); }
  .kpis dt { font-size: 0.9375rem; color: var(--c-text-muted-dark); }
  .kpis dd { margin: 0; font-family: var(--font-display); font-size: 3rem; line-height: 1.1; color: var(--c-gold); }
  .kpis span { font-size: 0.875rem; color: var(--c-text-muted-dark); }
  .kpis__warn dd { color: var(--c-offwhite); }
  .kpis__warn.is-on dd { color: #ff8a80; }
  .kpis__gut dd { color: #a8d5a2; }

  /* ---------- Abschnitte ---------- */
  .sec { padding-block: 3.5rem 5rem; }
  .sec__head { margin: 4rem 0 1.5rem; display: grid; gap: 0.5rem; }
  .sec__head:first-child { margin-top: 0; }

  /* ---------- Checkliste ---------- */
  .checks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .check { background: #fff; border: 1px solid var(--c-line-light); border-radius: 6px; padding: 1.5rem; }
  .check.is-fertig { border-color: #a8d5a2; }
  .check__head { display: flex; align-items: center; gap: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--c-line-light); }
  .check__name { font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.2; }
  .check__count { font-size: 0.9375rem; color: var(--c-text-muted-light); }
  .check__list { list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 0.625rem; }
  .check__list li { display: flex; align-items: flex-start; gap: 0.75rem; line-height: 1.4; }
  .check__box { flex: none; display: grid; place-items: center; width: 1.375rem; height: 1.375rem; margin-top: 0.05rem; border-radius: 50%; font-size: 0.8125rem; font-weight: 700; }
  .is-done .check__box { background: var(--c-gold); color: var(--c-aubergine); }
  .is-done .check__punkt { color: var(--c-text-muted-light); }
  .is-open .check__box { border: 2px solid var(--c-lavender); }
  .is-open .check__punkt { font-weight: 600; }
  .check__list .chip { margin-left: auto; }

  .chip { flex: none; padding: 0.125rem 0.625rem; border-radius: 1rem; font-size: 0.8125rem; font-weight: 600; background: var(--c-offwhite-deep); color: var(--c-aubergine); }
  .chip--leon { background: var(--c-aubergine); color: var(--c-offwhite); }
  .chip--zamin { background: var(--c-gold); color: var(--c-aubergine); }
  .chip--beide { background: var(--c-lavender); color: var(--c-aubergine); }

  /* ---------- Personen ---------- */
  .people { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; align-items: start; }
  .person { background: #fff; border: 1px solid var(--c-line-light); border-radius: 6px; padding: 1.5rem; }
  .person__head { display: flex; align-items: center; gap: 1rem; }
  .avatar { flex: none; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; font-family: var(--font-display); font-size: 1.625rem; }
  .avatar--leon { background: var(--c-aubergine); color: var(--c-gold); }
  .avatar--zamin { background: var(--c-gold); color: var(--c-aubergine); }
  .person__name { font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.2; }
  .person__rolle { font-size: 0.875rem; color: var(--c-text-muted-light); }
  .person__stat { margin-left: auto; text-align: right; font-size: 0.875rem; color: var(--c-text-muted-light); }
  .person__stat b { display: block; font-family: var(--font-display); font-size: 2rem; line-height: 1; font-weight: 400; color: var(--c-aubergine); }

  .bar { margin-top: 1.25rem; height: 8px; border-radius: 4px; background: var(--c-offwhite-deep); overflow: hidden; }
  .bar i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--c-lavender), var(--c-gold)); }
  .bar__text { margin-top: 0.375rem; font-size: 0.875rem; color: var(--c-text-muted-light); }

  .todos { list-style: none; padding: 0; margin-top: 1.25rem; display: grid; gap: 0.625rem; }
  .todo { display: flex; gap: 1rem; padding: 0.875rem 1rem; border-radius: 4px; background: var(--c-offwhite); border-left: 4px solid var(--c-lavender); }
  .todo--hoch { border-left-color: var(--c-gold); }
  .todo--wartet { border-left-style: dashed; }
  .todo.is-late { border-left-color: #c62828; background: #fbeeee; }
  .todo__main { flex: 1; min-width: 0; }
  .todo__text { font-weight: 600; line-height: 1.4; }
  .todo__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem 0.5rem; margin-top: 0.375rem; font-size: 0.8125rem; color: var(--c-text-muted-light); }
  .todo__notiz { margin-top: 0.375rem; font-size: 0.875rem; line-height: 1.5; color: var(--c-text-muted-light); }
  .todo__datum { flex: none; display: grid; place-content: center; text-align: center; width: 3.25rem; height: 3.25rem; border-radius: 4px; background: #fff; border: 1px solid var(--c-line-light); line-height: 1; }
  .todo__datum span { font-family: var(--font-display); font-size: 1.375rem; }
  .todo__datum small { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-gold-text); margin-top: 0.125rem; }
  .is-late .todo__datum { border-color: #c62828; color: #c62828; }

  .tag { display: inline-block; padding: 0.0625rem 0.5rem; border-radius: 1rem; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; background: var(--c-offwhite-deep); color: var(--c-aubergine); }
  .tag[hidden] { display: none; }
  .tag--arbeit { background: var(--c-lavender); }
  .tag--wartet { background: #ece3cf; color: var(--c-gold-text); }
  .tag--hoch { background: var(--c-gold); }
  .tag--late { background: #c62828; color: #fff; }

  .leer { margin-top: 1.25rem; color: var(--c-text-muted-light); }

  .done { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--c-line-light); }
  .done__title { font-size: var(--fs-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-gold-text); }
  .done ul { list-style: none; padding: 0; margin-top: 0.75rem; display: grid; gap: 0.5rem; }
  .done li { display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.9375rem; line-height: 1.4; color: var(--c-text-muted-light); }
  .done li small { margin-left: auto; flex: none; color: var(--c-text-muted-light); }
  .done__haken { flex: none; display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border-radius: 50%; background: #dcebdc; color: #24572b; font-size: 0.75rem; font-weight: 700; }

  /* ---------- Zeitplan ---------- */
  .time { list-style: none; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; position: relative; }
  .time::before { content: ''; position: absolute; left: 0; right: 0; top: 0.5rem; height: 2px; background: var(--c-line-light); }
  .time li { position: relative; display: grid; align-content: start; gap: 0.25rem; padding-right: 0.75rem; }
  .time__dot { position: relative; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--c-offwhite); border: 2px solid var(--c-lavender); margin-bottom: 0.5rem; }
  .time li.is-past .time__dot { background: var(--c-lavender); }
  .time li.is-past .time__title { color: var(--c-text-muted-light); }
  .time li.is-next .time__dot { background: var(--c-gold); border-color: var(--c-gold); box-shadow: 0 0 0 5px rgb(191 158 93 / 0.25); }
  .time li.is-next .time__title { font-weight: 700; }
  .time__date { font-size: 0.875rem; font-weight: 700; color: var(--c-gold-text); }
  .time__title { font-size: 0.9375rem; line-height: 1.35; }

  .hinweis { margin-top: 4rem; padding-top: 1rem; border-top: 1px solid var(--c-line-light); font-size: 0.875rem; color: var(--c-text-muted-light); }

